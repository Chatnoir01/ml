cc_library_static {
    name: "libsecure_core_avf_attestation_bridge",
    srcs: [
        "avf_attestation_bridge.cpp",
        "avf_profile_pin_bridge.cpp",
    ],
    export_include_dirs: ["."],
    // Production provisioning injects SCM_AVF_PROFILE_PIN_HEX at build time
    // from reviewed material. The repository intentionally provides no default.
    shared_libs: ["libvm_payload#current"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
